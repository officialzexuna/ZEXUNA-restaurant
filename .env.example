# GEMINI_API_KEY: Required for server-side Gemini AI Restaurant Assistant.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted.
APP_URL="MY_APP_URL"

# ADMIN_BOOTSTRAP_EMAIL: Primary Google account authorized for initial Admin onboarding.
# Defaults to the workspace owner email if unset.
ADMIN_BOOTSTRAP_EMAIL="official.zexuna@gmail.com"

# Optional: Firebase Admin SDK service account JSON string for privileged server-side writes.
# If omitted, server routes authenticate requests via Firebase ID tokens and Firestore REST API.
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Optional: Real SMTP email configuration for reservation & enquiry notifications (Nodemailer).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ZEXUNA Restaurant <reservations@example.com>"

# Optional: Official WhatsApp Business Cloud API credentials for automated notifications.
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
